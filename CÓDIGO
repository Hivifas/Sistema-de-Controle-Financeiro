        "# --- DECLARAÇÃO DE VARIÁVEIS ---\n",
        "# Armazena o valor total acumulado das entradas (ex: salário)\n",
        "receitas = 0.0\n",
        "\n",
        "# Cria uma lista vazia para armazenar o histórico de despesas\n",
        "despesas = []\n",
        "\n",
        "# --- LAÇO PRINCIPAL ---\n",
        "# Inicia um loop infinito para manter o programa rodando até o usuário decidir sair\n",
        "while True:\n",
        "    # Exibe o menu principal na tela para o usuário\n",
        "    print(\"\\n===== CONTROLE FINANCEIRO =====\")\n",
        "    print(\"1 - Adicionar receita\")\n",
        "    print(\"2 - Adicionar despesa\")\n",
        "    print(\"3 - Listar despesas\")\n",
        "    print(\"4 - Ver saldo\")\n",
        "    print(\"5 - Ver resumo\")\n",
        "    print(\"0 - Sair\")\n",
        "\n",
        "    # Lê a opção digitada pelo usuário\n",
        "    opcao = input(\"Escolha uma opção: \")\n",
        "\n",
        "    # --- OPÇÃO 1: ADICIONAR RECEITA ---\n",
        "    if opcao == \"1\":\n",
        "        # Pede o valor da receita e converte o texto para número decimal (float)\n",
        "        valor = float(input(\"Digite o valor da receita (ex: salário): R$ \"))\n",
        "        # Soma o novo valor ao total de receitas acumuladas\n",
        "        receitas += valor\n",
        "        # Confirma a adição para o usuário\n",
        "        print(\"Receita adicionada com sucesso!\")\n",
        "\n",
        "    # --- OPÇÃO 2: ADICIONAR DESPESA ---\n",
        "    elif opcao == \"2\":\n",
        "        # Lê a categoria da despesa (ex: Alimentação, Aluguel)\n",
        "        categoria = input(\"Digite a categoria da despesa (ex: Alimentação): \")\n",
        "        # Lê o valor da despesa e converte para número decimal\n",
        "        valor = float(input(\"Digite o valor da despesa: R$ \"))\n",
        "        # Adiciona um dicionário com a categoria e o valor dentro da lista 'despesas'\n",
        "        despesas.append({\"categoria\": categoria, \"valor\": valor})\n",
        "        # Confirma o registro da despesa\n",
        "        print(\"Despesa registrada com sucesso!\")\n",
        "\n",
        "    # --- OPÇÃO 3: LISTAR DESPESAS ---\n",
        "    elif opcao == \"3\":\n",
        "        print(\"\\n--- LISTA DE DESPESAS ---\")\n",
        "        # Verifica se a lista de despesas está vazia\n",
        "        if len(despesas) == 0:\n",
        "            print(\"Nenhuma despesa registrada.\")\n",
        "        else:\n",
        "            # Percorre cada item da lista de despesas e imprime seus detalhes\n",
        "            for item in despesas:\n",
        "                print(\n",
        "                    f\"Categoria: {item['categoria']} | Valor: R$ {item['valor']:.2f}\"\n",
        "                )\n",
        "\n",
        "    # --- OPÇÃO 4: VER SALDO ---\n",
        "    elif opcao == \"4\":\n",
        "        # Inicializa a variável para somar o total gasto\n",
        "        total_despesas = 0.0\n",
        "        # Percorre a lista de despesas e acumula os valores\n",
        "        for item in despesas:\n",
        "            total_despesas += item[\"valor\"]\n",
        "\n",
        "        # Calcula o saldo subtraindo as despesas do total de receitas\n",
        "        saldo = receitas - total_despesas\n",
        "        # Exibe o saldo atual formatado com 2 casas decimais\n",
        "        print(f\"\\nSaldo Atual: R$ {saldo:.2f}\")\n",
        "\n",
        "    # --- OPÇÃO 5: VER RESUMO ---\n",
        "    elif opcao == \"5\":\n",
        "        # Inicializa a variável para calcular o total de despesas\n",
        "        total_despesas = 0.0\n",
        "        # Soma todos os valores da lista de despesas\n",
        "        for item in despesas:\n",
        "            total_despesas += item[\"valor\"]\n",
        "\n",
        "        # Calcula o saldo final\n",
        "        saldo = receitas - total_despesas\n",
        "        # Exibe o relatório completo de entradas, saídas e saldo restante\n",
        "        print(\"\\n--- RESUMO FINANCEIRO ---\")\n",
        "        print(f\"Total de Entradas (Receitas): R$ {receitas:.2f}\")\n",
        "        print(f\"Total de Saídas (Despesas): R$ {total_despesas:.2f}\")\n",
        "        print(f\"Saldo Final: R$ {saldo:.2f}\")\n",
        "\n",
        "    # --- OPÇÃO 0: SAIR ---\n",
        "    elif opcao == \"0\":\n",
        "        # Exibe mensagem de encerramento e interrompe o laço com 'break'\n",
        "        print(\"Encerrando o programa. Até logo!\")\n",
        "        break\n",
        "\n",
        "    # --- TRATAMENTO DE OPÇÃO TRATADA/INVÁLIDA ---\n",
        "    else:\n",
        "        # Caso o usuário digite um caractere fora das opções do menu\n",
        "        print(\"Opção inválida! Escolha um número do menu.\")"
      ]
    }
